{
  "version": "privacy-policy-v3",
  "status": "prototype_assumption",
  "tiers": {
    "P0": {
      "name": "Public",
      "meaning": "No personal data."
    },
    "P1": {
      "name": "Personal",
      "meaning": "Identifies the driver's life with low harm if exposed in masked form (contacts, saved places, preferences, session references)."
    },
    "P2": {
      "name": "Sensitive",
      "meaning": "Harmful if exposed: health, finances, legal matters, direct contact details."
    },
    "P3": {
      "name": "Restricted",
      "meaning": "Must never leave the device in any form: credentials, payment cards, government IDs, bank account numbers."
    }
  },
  "reference_types": {
    "person": {
      "category": "identity",
      "tier": "P1",
      "maskable": true
    },
    "location": {
      "category": "location",
      "tier": "P1",
      "maskable": true
    },
    "preference": {
      "category": "preference",
      "tier": "P1",
      "maskable": true
    },
    "session_reference": {
      "category": "session",
      "tier": "P1",
      "maskable": true
    },
    "personal_detail": {
      "category": "personal_detail",
      "tier": "P1",
      "maskable": true
    },
    "other_private": {
      "category": "other_private",
      "tier": "P1",
      "maskable": true
    },
    "contact_detail": {
      "category": "contact_detail",
      "tier": "P2",
      "maskable": true
    }
  },
  "context_sources": {
    "private_db": {
      "category": "saved_data",
      "tier": "P1",
      "maskable": true
    },
    "session": {
      "category": "session",
      "tier": "P1",
      "maskable": true
    }
  },
  "content_categories": {
    "health": {
      "tier": "P2",
      "maskable": false,
      "terms": [
        "diagnosis",
        "diagnosed",
        "symptom",
        "symptoms",
        "medication",
        "medications",
        "prescription",
        "therapy",
        "therapist",
        "blood test",
        "blood pressure",
        "blood sugar",
        "cholesterol",
        "diabetes",
        "diabetic",
        "cancer",
        "chemotherapy",
        "pregnant",
        "pregnancy",
        "mental health",
        "depression",
        "anxiety",
        "panic attack",
        "hiv",
        "allergy",
        "allergic",
        "surgery",
        "insulin",
        "dosage",
        "medical",
        "health plan",
        "illness",
        "disease",
        "psychiatrist",
        "rehab"
      ]
    },
    "finance": {
      "tier": "P2",
      "maskable": false,
      "terms": [
        "salary",
        "income",
        "bank balance",
        "account balance",
        "debt",
        "loan",
        "mortgage",
        "credit score",
        "credit card bill",
        "tax return",
        "taxes owed",
        "net worth",
        "overdraft",
        "bankruptcy",
        "paycheck",
        "savings account",
        "investment portfolio",
        "my investments"
      ]
    },
    "legal": {
      "tier": "P2",
      "maskable": false,
      "terms": [
        "lawsuit",
        "court date",
        "court case",
        "arrested",
        "arrest",
        "criminal record",
        "police record",
        "dui",
        "custody",
        "divorce",
        "my lawyer",
        "immigration status",
        "visa status",
        "probation",
        "restraining order"
      ]
    }
  },
  "patterns": {
    "credential": {
      "tier": "P3",
      "maskable": false,
      "regex": "\\b(?:password|passcode|passphrase|pin|security code|one[- ]time code|otp)\\s*(?:is|was|:|=)\\s*(?!(?:too|wrong|incorrect|expired|long|short|weak|strong|not|located|missing|lost|forgotten|required|needed|reset|changed|the|a|an|my|your|invalid|correct|right|case|easy|hard|different|same|blocked|locked|saved|stored|updated|new|old)\\b)[^\\s.,;!?]+"
    },
    "payment_card": {
      "tier": "P3",
      "maskable": false,
      "regex": "(?<!\\d)(?:\\d[ -]?){12,18}\\d(?!\\d)",
      "checksum": "luhn"
    },
    "government_id": {
      "tier": "P3",
      "maskable": false,
      "regex": "(?<!\\d)\\d{3}[ -]\\d{3}[ -]\\d{3}(?!\\d)",
      "checksum": "luhn"
    },
    "bank_account": {
      "tier": "P3",
      "maskable": false,
      "regex": "\\b(?:account|acct|transit|routing|institution)\\s*(?:number|no\\.?|#)?\\s*(?:is|:)?\\s*\\d{5,}"
    },
    "email": {
      "tier": "P2",
      "maskable": true,
      "regex": "[\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,}"
    },
    "phone": {
      "tier": "P2",
      "maskable": true,
      "regex": "(?<![\\w+])(?:\\+?1[ .-]?)?(?:\\(\\d{3}\\)\\s?|\\d{3}[ .-])\\d{3}[ .-]\\d{4}(?!\\w)|(?<![\\w+])\\+?1?\\d{10}(?!\\w)"
    },
    "address": {
      "tier": "P2",
      "maskable": true,
      "regex": "(?-i:\\b\\d{1,6}\\s+(?:[A-Z][A-Za-z'.-]*\\s+){1,4}(?:Street|St|Road|Rd|Avenue|Ave|Drive|Dr|Boulevard|Blvd|Lane|Ln|Crescent|Cres|Court|Ct|Way|Parkway|Pkwy|Place|Pl)\\b\\.?)"
    }
  },
  "decision": {
    "simple": "Simple and uncertain requests always stay on the local model, whatever their tier.",
    "complex": {
      "P0": "privacy_layer",
      "P1": "privacy_layer",
      "P2_maskable": "privacy_layer",
      "P2_content": "local_slm",
      "P3": "local_slm"
    }
  },
  "role_descriptors": {
