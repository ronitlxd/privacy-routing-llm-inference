# Copy to .env and adjust. Never commit .env or any API key file.

# Server
HOST=127.0.0.1             # 127.0.0.1 = this computer only (use an SSH tunnel). A network address needs HTTPS:
# JLR_TLS_CERT=certs/site-cert.pem   # certificate and key for HTTPS (./install.sh --access makes a self-signed pair)
# JLR_TLS_KEY=certs/site-key.pem
PORT=8770
JLR_HOME_PAGE=driver       # the driver screen at / (the inspector stays at /inspector)

# Driver profiles: encrypted private databases, one per driver.
JLR_PROFILES_DIR=profiles
# Demo driver: the site creates Alex with sample data (password 1234) and new sessions start signed in as Alex.
# The password is public, so keep only sample data in Alex. 0 = no demo driver, sessions start as Guest.
JLR_DEMO_PROFILE=1
# JLR_DEMO_PASSWORD=1234     # password for a newly created Alex
JLR_MIN_PASSWORD=4          # minimum profile password length (4 allows a short PIN; raise it for stronger profiles)
JLR_MAX_PROFILES=20
# Without JLR_PROFILES_DIR, every session shares one sample database instead:
# JLR_V2_DB=jlr/jlr_demo.sqlite3

# Models. Preferred: models.toml (copy models.example.toml): one file for where the router, local and larger
# models run (Ollama, any OpenAI-compatible server, or Anthropic) with privacy rules checked at start-up.
# JLR_MODELS_FILE=models.toml        # another path for that file
# Without models.toml, the settings below are used.

# Local models (Ollama)
JLR_OLLAMA_URL=http://127.0.0.1:11434
# Ollama receives unmasked prompts: this machine (plain HTTP to a loopback address) or HTTPS only.
# A remote plain-HTTP address stops the server. Remote options: SSH tunnel
#   ssh -N -L 11434:127.0.0.1:11434 <user>@<host>   (keep http://127.0.0.1:11434 above)
# or a TLS proxy in front of Ollama (https://<host>); private CA: JLR_OLLAMA_CA_FILE=/path/ca.pem
# Argon2id settings for profile keys (time-optimised default 64 MiB, 3 passes, 4 lanes):
# JLR_ARGON2_MEMORY_KIB=65536
# JLR_ARGON2_PASSES=3
# Older .env-only model settings (before models.toml); the installer writes models.toml instead.
# There are no default models: name the ones you run.
# JLR_ROUTER_MODEL=<small model>
# JLR_V2_LOCAL_MODEL=<small model>
# JLR_V2_LARGER_MODEL=<large model>
# Larger model provider: ollama | anthropic | openai (any OpenAI-compatible server); it receives masked text only.
# JLR_V2_LARGER_PROVIDER=anthropic
# JLR_LARGER_API_KEY=...            # or ANTHROPIC_API_KEY / OPENAI_API_KEY; never commit it
# JLR_LARGER_BASE_URL=http://host:8000/v1   # openai provider only, for self-hosted servers
JLR_NUM_GPU=-1            # router + local: -1 = offload as much as fits, 0 = CPU only
# JLR_LARGER_NUM_GPU=0    # local larger model: 0 = CPU, -1 = GPU (when both models fit in its memory)
# JLR_ROUTER_UNTUNED_OK=1 # accept a router model the routing profile was not tuned for (re-test routing first)
JLR_THREADS=4

# Deadlines in seconds
JLR_V2_ROUTER_DEADLINE=45
JLR_V2_LOCAL_DEADLINE=90
JLR_V2_LARGER_DEADLINE=150
JLR_V2_REQUEST_DEADLINE=180   # budget for one run of the model loop (time spent answering questions is not counted)

# Routing
# JLR_ROUTING_PROFILE=jlr/routing_profile.json   # default
# JLR_PRIVACY_POLICY=jlr/privacy_policy.json      # default
# JLR_LOCAL_ONLY=1                                  # force every request onto the local model

# Map tools (OpenStreetMap)
JLR_INTERNET_TOOLS=1
JLR_NOMINATIM_URL=https://nominatim.openstreetmap.org
JLR_PHOTON_URL=https://photon.komoot.io       # spelling-tolerant fallback search
JLR_OSM_ROUTER_URL=https://router.project-osrm.org

# Privacy receipt log (one line per request; no prompt, answer or private value)
JLR_RECEIPT_LOG=logs/privacy_receipts.jsonl

# Configured starting location (not GPS). Default: Windsor City Hall.
JLR_ORIGIN_ADDRESS=Windsor City Hall, 350 City Hall Square West, Windsor, Ontario, Canada
JLR_ORIGIN_LATITUDE=42.317102946666665
JLR_ORIGIN_LONGITUDE=-83.03487285333334
